<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>footer</title>
</head>

<body>

<footer>
<hr>
    <div class="container">
      <div class="footer-content">
        <h1>Museu Virtual de Sertanópolis</h1>
        <p>Preservando a memória, conectando pessoas e tecnologia.</p>
      </div>
      <div class="footer-content">
        <nav class="navegacao">
          <h3>Navegação</h3>
          <ul>
            <li><a href="/">Início</a></li>
            <li><a href="/acervo3d">Acervo 3D</a></li>
            <li><a href="/museuHistorico">Museu histórico</a></li>
            <li><a href="/curiosidades">Curiosidades</a></li>
            <li><a href="">Sobre o projeto</a></li>
          </ul>
        </nav>
      </div>

      <div class="footer-content">
        <h3>Realizações e apoio</h3>
        <ul class="apoio">
          <li class="apoio-item">Grupo de Realidade Aumentada</li>
          <li class="apoio-item">UniFil</li>
        </ul>
      </div>
    </div>
    <hr>
    <p>© 2026 Museu Virtual de Sertanópolis. Todos os direitos reservados.</p>
</footer>

  <style>
  :root {
            --cor-vermelha-principal: rgb(151, 44, 44);
            --cor-azul-principal: rgb(8, 8, 106);
            --cor-azul-secundaria: #14678c;
            --cor-dourada: #d8a85f;
            --cor-fundo: whitesmoke;
            --cor-fundo-footer: whitesmoke;
            --cor-branca: #ffffff;
            --cor-texto: #444444;
            --cor-borda: #e8e1d8;
            --cor-borda-cinza: #d9d2c8;
}
p {
    padding: 10px;
}

a {
    color: black;
    text-decoration: none;
}

a:hover {
    color: var(--cor-vermelha-principal);
    text-decoration: underline;
}
  li {
    list-style-type: none;
}

* {
    margin: 0;
    padding: 0;
}

footer {
    margin-top: 0;
    background-color: var(--cor-fundo);
    color: black;
    padding: 0px;
    text-align: center;
    font-family: 'Cinzel', serif;
}

.container {
    display: flex;
    flex-direction: row;
    text-align: left;
    justify-content: center;
    align-items: flex-start;
}

.footer-content {
    display: flex;
    flex-direction: column;
    padding: 60px;
}

footer h1 {
    padding: 5px;
    text-align: start;
    font-size: 25px;
    color: var(--cor-vermelha-principal);
    font-weight: bold;
}

footer h3 {
    text-transform: uppercase;
    color: var(--cor-azul-principal);
    font-weight: bold;
    padding-bottom: 20px;
}

footer p{
    padding: 10px;
}

footer .footer-content p {
    text-align: start;
    font-size: 20px;
}

footer ul {
    padding: 0;
    margin: 0;
}

footer li {
    text-align: start;
    font-size: 20px;
    padding: 4px;
}

footer .apoio{
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

.apoio-item {
    border: #a3a3a3 solid 1px;
    border-radius: 5px;
    padding: 7px;
    background-color: whitesmoke;
    text-align: center;
}

@media (max-width: 768px){
    .container{
        flex-direction: column;
        align-item: stretch;
        gap: 20px;
    }

    .footer-content {
        padding: 20px 10px;
    }

    footer h1 {
        font-size: 22px;
    }

    footer h3 {
        font-size: 18px;
        padding-bottom: 10px;
    }

    footer .footer-content p,
    footer li {
        font-size: 17px;
    }

    footer .apoio {
        justify-content: flex-start;
    }
}
</style>
</body>
</html>

