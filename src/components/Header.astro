<!DOCTYPE html>
<html lang="pt-BR">
    <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Header</title>
    </head>
    <body>

    <header>
    <div class="header-container">

    <div class="logo">
      <span class="logo-menor">MUSEU VIRTUAL</span>
      <span class="logo-maior">Sertanópolis</span>
    </div>

    <nav class="menu">
      <a href={import.meta.env.BASE_URL}>Início</a>
      <a href={`${import.meta.env.BASE_URL}/acervo3d`}>Acervo 3D</a>
      <a href={`${import.meta.env.BASE_URL}/museuHistorico`}>Museu Histórico</a>
      <a href={`${import.meta.env.BASE_URL}/curiosidades`}>Curiosidades</a>
    </nav>

    <div class="acoes">
      <a class="botao-ra" href="#">
        ⚛ Realidade Aumentada
      </a>
    </div>

  </div>
</header>

        <style>
        :root {
            --cor-vermelha-principal: rgb(151, 44, 44);
            --cor-azul-principal: rgb(8, 8, 106);
            --cor-azul-secundaria: #14678c;
            --cor-dourada: #d8a85f;
            --cor-fundo: whitesmoke;
            --cor-fundo-footer: whitesmoke;
            --cor-branca: #ffffff;
            --cor-texto: #444444;
            --cor-borda: #e8e1d8;
            --cor-borda-cinza: #d9d2c8;
        }
            

            header {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;

                background-color: var(--cor-fundo);
                border-bottom: 1px solid var(--cor-borda);

                z-index: 1000;
            }

            .header-container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 16px 24px;

            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 30px;
            }

            .logo {
            display: flex;
            flex-direction: column;
            }

            .logo-menor {
            font-size: 11px;
            letter-spacing: 4px;
            color: var(--cor-azul-principal);
            }

            .logo-maior {
            font-size: 23px;
            color: var(--cor-vermelha-principal);
            font-family: Georgia, serif;
            }

            .menu {
            display: flex;
            align-items: center;
            gap: 28px;
            }

            .menu a {
            color: var(--cor-texto);
            text-decoration: none;
            font-size: 15px;
            }

            .menu a:hover,
            .menu a.ativo {
            color: var(--cor-vermelha-principal);
            }

            .acoes {
            display: flex;
            align-items: center;
            gap: 14px;
            }

            .busca {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            border: 1px solid #d9d2c8;
            background: transparent;
            cursor: pointer;
            }

            .botao-ra {
            border: 1px solid var(--cor-dourada);
            border-radius: 30px;
            padding: 10px 18px;
            color: var(--cor-azul-principal);
            text-decoration: none;
            font-size: 14px;
            }

            @media (max-width: 900px) {
            .header-container {
                flex-wrap: wrap;
            }

            .menu {
                order: 3;
                width: 100%;
                justify-content: center;
                flex-wrap: wrap;
            }
            }

            @media (max-width: 600px) {
            .header-container {
                flex-direction: column;
                align-items: flex-start;
            }

            .menu {
                flex-direction: column;
                align-items: flex-start;
                gap: 12px;
            }

            .acoes {
                width: 100%;
                justify-content: space-between;
            }
            }
        </style>
    </body>
</html>