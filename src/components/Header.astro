<!DOCTYPE html>
<html lang="pt-BR">
    <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Header</title>
    </head>
    <body>

    <header>
    <div class="header-container">

    <div class="logo">
      <span class="logo-menor">MHC²IT</span>
      <span class="logo-maior">VIRTUAL</span>
    </div>

    <nav class="menu">
      <a href={import.meta.env.BASE_URL}>Início</a>
      <a href={`${import.meta.env.BASE_URL}/acervo3d`}>Acervo 3D</a>
      <a href={`${import.meta.env.BASE_URL}/museuHistorico`}>Museu Histórico</a>
      <a href={`${import.meta.env.BASE_URL}/curiosidades`}>Curiosidades</a>
      <a href={`${import.meta.env.BASE_URL}/cidade`}>Cidade de Sertanópolis</a>
    </nav>

<div class="acoes">
    <button
        class="botao-menu"
        id="botao-menu"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="menu-navegacao"
    >
        <span class="icone-menu">☰</span>
    </button>
</div>

  </div>
</header>

        <style>
        :root {
            --cor-vermelha-principal: rgb(151, 44, 44);
            --cor-azul-principal: rgb(8, 8, 106);
            --cor-azul-secundaria: #14678c;
            --cor-dourada: #d8a85f;
            --cor-fundo: whitesmoke;
            --cor-fundo-footer: whitesmoke;
            --cor-branca: #ffffff;
            --cor-texto: #444444;
            --cor-borda: #e8e1d8;
            --cor-borda-cinza: #d9d2c8;
        }
            

            header {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;

                background-color: var(--cor-fundo);
                border-bottom: 1px solid var(--cor-borda);

                z-index: 1000;
            }

            .header-container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 16px 24px;

            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 30px;
            }

            .logo {
            display: flex;
            flex-direction: column;
            font-family: 'Bauhaus 93', sans-serif;
            font-weight: normal;
            }

            .logo-menor {
            font-size: 20px;
            letter-spacing: 4px;
            color: var(--cor-azul-principal);
            }

            .logo-maior {
            font-size: 25px;
            color: var(--cor-vermelha-principal);
            }

            .menu {
            display: flex;
            align-items: center;
            gap: 28px;
            }

            .menu-aberto {
                display: flex !important;
            }

            .menu a {
            color: var(--cor-texto);
            text-decoration: none;
            font-size: 20px;
            font-family: 'Abadi Extra Light', sans-serif;
            font-weight: bold;
            }

            .menu a:hover,
            .menu a.ativo {
            color: var(--cor-vermelha-principal);
            }

            .acoes {
            display: flex;
            align-items: center;
            gap: 14px;
            }

            .acoes {
            display: flex;
            align-items: center;
            gap: 14px;
            }

            .botao-menu {
            display: none;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            border: 1px solid var(--cor-borda-cinza);
            background: transparent;
            color: var(--cor-texto);
            cursor: pointer;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            }

        @media (max-width: 900px) {
            .header-container {
                flex-wrap: nowrap;
                padding: 12px 20px;
                justify-content: space-between;
            }

            .menu {
                display: flex;
                flex-direction: column;
                align-items: flex-start;
                position: absolute;
                top: 100%;
                left: 0;
                width: 100%;
                padding: 0 20px;
                box-sizing: border-box;
                background-color: var(--cor-fundo);
                border-bottom: 1px solid var(--cor-borda);

                max-height: 0;
                overflow: hidden;
                opacity: 0;
                visibility: hidden;

                transition:
                    max-height 0.8s ease,
                    opacity 0.8s ease,
                    padding 0.8s ease,
                    visibility 0.8s;
            }

            .menu.menu-aberto {
                max-height: 300px;
                padding: 20px;
                opacity: 1;
                visibility: visible;
                gap: 20px;
            }

            .menu.menu-aberto a {
                font-size: 16px;
            }

            .botao-menu {
                display: flex;
            }

            .acoes {
                display: flex;
                align-items: center;
            }
        }
            

        @media (max-width: 600px) {
            .header-container {
                flex-direction: row;
                align-items: center;
                justify-content: space-between;
            }

            .menu {
                display: none;
            }

            .acoes {
                width: auto;
                justify-content: flex-end;
            }
        }
        </style>
        <script>
            const botaoMenu = document.querySelector('#botao-menu');
            const menu = document.querySelector('.menu');
            const iconeMenu = document.querySelector('.icone-menu');

            botaoMenu?.addEventListener('click', () => {
                const aberto = botaoMenu.getAttribute('aria-expanded') === 'true';

                botaoMenu.setAttribute('aria-expanded', String(!aberto));
                botaoMenu.setAttribute(
                    'aria-label',
                    aberto ? 'Abrir menu' : 'Fechar menu'
                );

                menu?.classList.toggle('menu-aberto', !aberto);
                iconeMenu.textContent = aberto ? '☰' : '✕';
            });
        </script>
    </body>
</html>