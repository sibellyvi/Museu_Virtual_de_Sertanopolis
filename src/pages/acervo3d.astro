---
import "../styles/acervo3d.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Botao from "../components/Botao.astro";

const titulo = "Acervo 3D";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// ar: true mostra o selo "Realidade Aumentada" no card
const acervo = [
  {
    nome: "Aparelho de inalação",
    categoria: "Saúde",
    descricao: "Ano: 1950",
    imagem: `${base}/modelos_gaussian/imagens/inalador.png`,
    pagina: `${base}/modelos_gaussian/html/inalador-isolado-centralizado.html`,
    ar: true,
  },
  {
    nome: "Cofre",
    categoria: "Objetos do cotidiano",
    descricao: "Cofre miniatura em formato de sapato na cor preto. Ano: 1932",
    imagem: `${base}/modelos_gaussian/imagens/cofre-sapato.png`,
    pagina: `${base}/modelos_gaussian/html/cofre-isolado.html`,
    ar: true,
  },
  {
    nome: "Lâmina de Machado de Pedra",
    categoria: "Objetos indígena",
    descricao: "Encontrado no Sítio São Luiz na Água do Tigre. Incorporado no ano de 2000",
    imagem: `${base}/modelos_gaussian/imagens/machado.png`,
    pagina: `${base}/modelos_gaussian/html/machado-isolado.html`,
    ar: true,
  },
  {
    nome: "Lampião à querosene",
    categoria: "Objetos do cotidiano",
    descricao: "Utilizado pela família da Pioneira Euvira Maria Torezan Migliozzi nas décadas de 30 e 40",
    imagem: `${base}/modelos_gaussian/imagens/lampiao.png`,
    pagina: `${base}/modelos_gaussian/html/lampiao-isolado.html`,
    ar: true,
  },
];

// Categorias geradas automaticamente a partir da lista acima
const categorias = [...new Set(acervo.map((item) => item.categoria))];

// Texto sem acento e em minúsculas, usado pela busca
const normalizar = (texto: string) =>
  texto.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{titulo}</title>
  <script
    is:inline
    type="module"
    src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
</head>

<body>
  <Header />

  <section class="secao-destaque">
    <div class="topo">
      <h1>Visite nosso {titulo}</h1>
      <p class="intro">
        Boas-vindas ao acervo 3D do MHC²IT. Aqui você pode conhecer o
        patrimônio histórico material de Sertanópolis em diferentes dimensões,
        além de fazer uma visita em realidade aumentada.
      </p>
    </div>

    <model-viewer
      id="viewer-lustre"
      src={`${base}/modelos3d/lustre.glb`}
      alt="Modelo 3D de um lustre"
      ar
      ar-modes="webxr scene-viewer quick-look"
      camera-controls
      style="width: 100%; height: 500px;"
    >
    </model-viewer>
    <p>Modelo 3D de um lustre do Centro de Convivência Maria Betiol Secco, antigo Clube Recreativo Operário</p>

    <div class="area-ar">
      <Botao id="botao-ar" variante="dourado">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path>
          <path d="M12 8.2l3.2 1.8v3.6L12 15.4l-3.2-1.8V10zM12 12v3.4M8.8 10l3.2 2 3.2-2"></path>
        </svg>
        Ver em realidade aumentada
      </Botao>
    </div>
    <p id="aviso-ar" class="aviso-ar" hidden>
      Seu dispositivo não suporta realidade aumentada. Abra esta página em um
      celular compatível.
    </p>
  </section>

  <section class="secao-acervo">
  <h1>{titulo}</h1>

  <section class="filtros">
    <label class="busca-acervo">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
      </svg>
      <input
        id="campo-busca"
        type="search"
        placeholder="Pesquisar no acervo..."
        autocomplete="off"
        aria-label="Pesquisar no acervo"
      />
    </label>

    <div class="chips" role="group" aria-label="Filtrar por categoria">
      <Botao variante="filtro" class="ativo" data-categoria="todos" aria-pressed="true">
        Todos
      </Botao>
      {
        categorias.map((cat) => (
          <Botao variante="filtro" data-categoria={cat} aria-pressed="false">
            {cat}
          </Botao>
        ))
      }
    </div>

    <p id="contador" class="contador" aria-live="polite"></p>
  </section>

  <div class="acervo-grid">
    {
      acervo.map((item) => (
        <article
          class="card-acervo"
          data-categoria={item.categoria}
          data-busca={normalizar(`${item.nome} ${item.categoria} ${item.descricao}`)}
        >
          <div class="card-imagem">
            {item.ar && (
              <span class="selo-ar">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path>
                </svg>
                Realidade Aumentada
              </span>
            )}
            <img src={item.imagem} alt={item.nome} loading="lazy" />
          </div>

          <div class="card-conteudo">
            <span class="categoria">{item.categoria}</span>
            <h3>{item.nome}</h3>
            <p>{item.descricao}</p>
            <div class="card-acao">
              <Botao href={item.pagina} variante="azul" pequeno>Explorar em 3D →</Botao>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <p id="sem-resultados" class="sem-resultados" hidden>
    Nenhuma peça encontrada. Tente outra palavra ou categoria.
  </p>
  </section>

  <Footer />

  <script>
    // Botão de realidade aumentada do lustre
    const viewer = document.getElementById("viewer-lustre") as any;
    const botaoAr = document.getElementById("botao-ar");
    const avisoAr = document.getElementById("aviso-ar");

    botaoAr?.addEventListener("click", async () => {
      await customElements.whenDefined("model-viewer");
      if (viewer?.canActivateAR) {
        viewer.activateAR();
      } else if (avisoAr) {
        avisoAr.hidden = false;
      }
    });

    // Busca + filtro por categoria
    const campoBusca = document.getElementById("campo-busca") as HTMLInputElement;
    const chips = document.querySelectorAll<HTMLElement>(".btn--filtro");
    const cards = document.querySelectorAll<HTMLElement>(".card-acervo");
    const contador = document.getElementById("contador");
    const semResultados = document.getElementById("sem-resultados");

    let categoriaAtiva = "todos";

    const normalizar = (t: string) =>
      t.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();

    function aplicarFiltros() {
      const termo = normalizar(campoBusca.value);
      let visiveis = 0;

      cards.forEach((card) => {
        const okCategoria =
          categoriaAtiva === "todos" || card.dataset.categoria === categoriaAtiva;
        const okBusca = !termo || (card.dataset.busca ?? "").includes(termo);
        const mostrar = okCategoria && okBusca;
        card.hidden = !mostrar;
        if (mostrar) visiveis++;
      });

      if (contador) {
        contador.textContent =
          visiveis === 0
            ? "Nenhuma peça encontrada"
            : visiveis === 1
              ? "1 peça encontrada"
              : `${visiveis} peças encontradas`;
      }
      if (semResultados) semResultados.hidden = visiveis !== 0;
    }

    chips.forEach((chip) =>
      chip.addEventListener("click", () => {
        categoriaAtiva = chip.dataset.categoria ?? "todos";
        chips.forEach((c) => {
          const ativo = c === chip;
          c.classList.toggle("ativo", ativo);
          c.setAttribute("aria-pressed", String(ativo));
        });
        aplicarFiltros();
      })
    );

    campoBusca.addEventListener("input", aplicarFiltros);
    aplicarFiltros();
  </script>
</body>
</html>