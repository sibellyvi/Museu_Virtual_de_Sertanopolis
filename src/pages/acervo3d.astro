---
import "../styles/acervo3d.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const titulo = "Acervo 3D"

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const acervo = [
  {
    nome: "Aparelho de inalação",
    categoria: "Saúde",
    descricao: "Ano: 1950",
    imagem: `${base}/modelos_gaussian/imagens/inalador.png`,
    pagina: `${base}/modelos_gaussian/inalador-isolado-centralizado.html`
  },

  {
    nome: "Cofre com formato de sapato",
    categoria: "Objetos do cotidiano",
    descricao: "Ano: 1932",
    imagem: `${base}/modelos_gaussian/imagens/cofre-sapato.png`,
    pagina: `${base}/modelos_gaussian/inalador-isolado-centralizado.html`
  },

  {
    nome: "Machado (Lâmina)",
    categoria: "Objeto indígena",
    descricao: "Incorporado no ano: 2000",
    imagem: `${base}/modelos_gaussian/imagens/machado.png`,
    pagina: `${base}/modelos_gaussian/inalador-isolado-centralizado.html`
  }
];

---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{titulo}</title>
  <script
  type="module"
  src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
</head>

<body>
  <Header />
  <section class="topo">
    <span class="eyebrow">Patrimônio em 3D</span>
    <h1>{titulo}</h1>
    <p class="intro">
      Boas-vindas ao acervo 3D do MHC²IT. Aqui você pode conhecer o patrimônio
      histórico material de Sertanópolis em diferentes dimensões, além de fazer
      uma visita em realidade aumentada.
    </p>
  </section>

  <model-viewer
    src={`${base}/modelos3d/lustre.glb`}
    alt="Modelo 3D de um lustre"
    ar
    ar-modes="webxr scene-viewer quick-look"
    camera-controls
    style="width: 100%; height: 500px;"
  >
  </model-viewer>
  <p>Modelo 3D de um lustre do Clube Recreativo Operário</p>

  <button id="botao-ar" class="botao-ar" type="button">
  Ver em realidade aumentada
</button>
<p id="aviso-ar" class="aviso-ar" hidden>
  Seu dispositivo não suporta realidade aumentada. Abra esta página em um
  celular compatível.
</p>

<script>
  const viewer = document.getElementById("viewer-lustre");
  const botao = document.getElementById("botao-ar");
  const aviso = document.getElementById("aviso-ar");

  botao?.addEventListener("click", async () => {
    await customElements.whenDefined("model-viewer");
    if (viewer?.canActivateAR) {
      viewer.activateAR();
    } else if (aviso) {
      aviso.hidden = false;
    }
  });
</script>


  <hr>

  <h2>Acervo</h2>

<div class="acervo-grid">

  {
  acervo.map((item) => (
    <article class="card-acervo">

      <div class="card-imagem">
        <img
          src={item.imagem}
          alt={item.nome}
        />
      </div>

      <div class="card-conteudo">

        <span class="categoria">{item.categoria}</span>

        <h2>{item.nome}</h2>

        <p>{item.descricao}</p>

        <a href={item.pagina} class="botao-3d">
          Explorar em 3D →
        </a>

      </div>

    </article>
  ))
}

</div>

    <Footer />
</body>
</html>