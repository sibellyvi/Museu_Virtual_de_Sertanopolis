---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{titulo}</title>
</head>

<body>
  <Header />

  <main>
    <!-- Topo (fundo azul) -->
    <section class="topo-cidade">
      <div class="conteudo">
        <span class="eyebrow">Nossa cidade</span>
        <h1>{titulo}</h1>
        <p class="intro">História, documentos oficiais e o hino municipal de Sertanópolis.</p>
      </div>
    </section>

    <!-- Atalhos para as seções -->
    <nav class="atalhos" aria-label="Seções da página">
      <Botao href="#historia" variante="azul" pequeno>História da Cidade</Botao>
      <Botao href="#documentos" variante="azul" pequeno>Documentos oficiais</Botao>
      <Botao href="#hino" variante="azul" pequeno>Hino Municipal</Botao>
    </nav>

    <!-- História (fundo claro) -->
    <section class="secao secao-historia" id="historia">
      <div class="conteudo conteudo-leitura">
        <span class="rotulo">Memória</span>
        <h2>História de Sertanópolis</h2>
        <p class="abertura">{abertura}</p>
        {historia.map((paragrafo) => <p class="texto">{paragrafo}</p>)}
      </div>
    </section>

    <!-- Documentos oficiais (fundo creme) -->
    <section class="secao secao-documentos" id="documentos">
      <div class="conteudo conteudo-leitura">
        <span class="rotulo">Arquivo</span>
        <h2>Documentos oficiais</h2>
        <h3>{documento.titulo}</h3>
        <p class="fonte">{documento.fonte}</p>
        <blockquote class="documento">
          <p>{documento.texto}</p>
        </blockquote>
      </div>
    </section>

    <!-- Hino (fundo vermelho) -->
    <section class="secao secao-hino" id="hino">
      <div class="conteudo conteudo-hino">
        <span class="rotulo">Símbolos do município</span>
        <h2>Hino Municipal</h2>
        <p class="creditos">Letra: Pe. César Bano · Música: José Guerini</p>

        <div class="letra">
          {
            hino.map((bloco) =>
              bloco.tipo === "nota" ? (
                <p class="nota">{bloco.versos[0]}</p>
              ) : (
                <p class={bloco.tipo}>
                  {bloco.versos.map((verso) => (<><span>{verso}</span><br /></>))}
                </p>
              )
            )
          }
        </div>
      </div>
    </section>
  </main>

  <Footer />
</body>
</html>