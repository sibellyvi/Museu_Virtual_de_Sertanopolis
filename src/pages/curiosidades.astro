---
import "../styles/curiosidades.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Galeria from "../components/Galeria.astro";

const titulo = "Curiosidades";

// Para adicionar uma curiosidade nova, basta incluir mais um item aqui
const curiosidades = [
  {
    rotulo: "Registro civil",
    titulo: "Primeiro Registro de Nascimento",
    texto:
      "O primeiro registro de nascimento foi expedido em nome de Antonio Casagrande Pescador (filho de Pedro Pescador e Vitória Casagrande) no dia 27 de setembro de 1928.",
  },
  {
    rotulo: "Registro civil",
    titulo: "Primeiro Casamento Oficial",
    texto:
      "José Matesco e Elvira Maria da Conceição foram os primeiros a celebrarem casamento efetuado em Sertanópolis, no dia 20 de outubro de 1928.",
  },
  {
    rotulo: "Registro civil",
    titulo: "Primeiro Registro de Óbito",
    texto:
      "O primeiro óbito foi o de Antonio Refundini (menor), filho de Angelina Rossato e Emílio Refundini, no dia 28 de dezembro de 1928.",
  },
  {
    rotulo: "Educação",
    titulo: "A Primeira Aula da Cidade",
    texto:
      "Em 14 de junho de 1928 foi dada a primeira aula, ministrada pela primeira professora Sra. Antonia Fernandes.",
  },
  {
    rotulo: "Religião",
    titulo: "Criação da Primeira Paróquia",
    texto:
      "A Paróquia de Santa Terezinha do Menino Jesus foi criada no dia 14 de junho de 1929, por decreto de D. Fernando Tadei, Bispo de Jacarezinho. Nesse mesmo dia foi realizado o primeiro batizado, sendo este o de uma menina com o nome Maria.",
  },
  {
    rotulo: "Transporte",
    titulo: "A Primeira Estação Ferroviária",
    texto:
      "A primeira estação para embarque e recebimentos de mercadorias de Sertanópolis era a Estação Ferroviária de Frei Timóteo.",
  },
  {
    rotulo: "Educação",
    titulo: "Primeira Professora Formada",
    texto:
      "A primeira professora formada a lecionar no Município foi a Sra. Mariana Dias Ayres (Dona Mary), esposa do médico Dr. João Dias Ayres.",
  },
  {
    rotulo: "Economia",
    titulo: "A Primeira Serraria de Sertanópolis",
    texto:
      "O pioneiro Manoel Ferreira Gomes foi quem instalou (em sociedade) a primeira Serraria de Sertanópolis no ano de 1932. Foi preciso que juntamente com seus sócios construíssem a balsa sobre o rio Tibagi para o transporte dos equipamentos, pois a estrada de ferro só havia chegado à época até Jataizinho. Participou na II Grande Exposição de Curitiba no ano de 1934, e foi condecorado com o Diploma de Honra ao Mérito e Medalha de Ouro, pela qualidade das madeiras beneficiadas que representaram no evento o Município de Sertanópolis.",
  },
  {
    rotulo: "Saúde",
    titulo: "O Primeiro Médico Residente",
    texto: "O primeiro médico a residir no Município foi o Dr. Pedro Daros.",
  },
  {
    rotulo: "Transporte",
    titulo: "Viagens Longas e Difíceis",
    texto:
      "Uma viagem de Sertanópolis a Assis-SP, em épocas de chuva, durava de 28 a 30 dias.",
  },
];
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{titulo}</title>
</head>

<body>
  <Header />

  <main class="pagina-curiosidades">
    <section class="topo-curiosidades">
      <span class="eyebrow">{titulo}</span>
      <h1>Os primeiros passos de Sertanópolis</h1>
      <p class="intro">
        Fatos curtos sobre os primeiros registros, serviços e pioneiros do
        município.
      </p>
    </section>

    <section
      class="carrossel"
      data-carrossel
      aria-label="Curiosidades de Sertanópolis"
    >
      <div class="carrossel-controles">
        <button
          type="button"
          class="carrossel-seta"
          data-carrossel-anterior
          aria-label="Curiosidade anterior"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 5 8 12 15 19"></polyline>
          </svg>
        </button>
        <button
          type="button"
          class="carrossel-seta"
          data-carrossel-proximo
          aria-label="Próxima curiosidade"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 5 16 12 9 19"></polyline>
          </svg>
        </button>
      </div>

      <div
        class="carrossel-trilho"
        data-carrossel-trilho
        role="region"
        aria-label="Lista de curiosidades"
        tabindex="0"
      >
        {
          curiosidades.map((item) => (
            <article class="card-curiosidade">
              <span class="rotulo">{item.rotulo}</span>
              <h2>{item.titulo}</h2>
              <p>{item.texto}</p>
            </article>
          ))
        }
      </div>
    </section>

    <Galeria />
  </main>

  <Footer />

  <script>
    import "../scripts/carrossel.js";
  </script>
</body>
</html>