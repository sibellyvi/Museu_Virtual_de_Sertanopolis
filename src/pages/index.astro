---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const titulo = "Museu Virtual de Sertanópolis";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{titulo}</title>
</head>

<body>
  <Header />

  <section class="inicio">
    <h1>Museu Histórico, Cultural e Científico “Ivaldo Totti” <span id="red"> MHC²IT Virtual</span></h1>
    <h2>Projeto de Extensão Universitária desenvolvido com o apoio do Projeto Lumen e com a parceria do departamento de cultura e turismo de Sertanópolis</h2>
  </section>

  <section class="hero">
    <div class="hero-imagem">
      <img
        src={`${base}/banco-de-fotos/ar-401-paco-municipal-santo-soriani-1970.jpg`}
        alt="Paço Municipal Santo Soriani em 1970"
        class="imagem-museu"
      />
    </div>

    <div class="hero-conteudo">
      <div class="linha-decorativa"></div>

      <p>
        História, memória e tecnologia em uma nova forma de preservar o
        patrimônio.
      </p>

      <div class="hero-botoes">
        <a class="botao botao-principal" href={`${base}/acervo3d`}>
          Explorar o Acervo 3D
        </a>

        <a class="botao botao-secundario" href={`${base}/museuHistorico`}>
          Conheça o Museu
        </a>
      </div>
    </div>
  </section>

  <section class="sobre-projeto" id="sobre-projeto">
    <div class="sobre-container">
      <div class="sobre-texto">
        <h3>Conheça o projeto</h3>

        <h2>Patrimônio que cabe em qualquer tela</h2>

        <p>
          O <strong>Museu Virtual de Sertanópolis</strong> é um projeto de
          extensão universitário sem fins lucrativos, que visa preservar a
          memória e a história do município através da tecnologia. Com o uso de
          modelos 3D, realidade aumentada e recursos interativos, o projeto
          proporciona uma experiência única para os visitantes, permitindo que
          explorem o acervo do museu histórico de forma inovadora e acessível.
        </p>

        <a href={`${base}/museuHistorico`} class="link-historia">
          A história do museu →
        </a>
      </div>

      <div class="sobre-imagem">
        <img
          src={`${base}/imagens/ImagemMuseu.jpg`}
          alt="Imagem do Museu Histórico de Sertanópolis em 2006"
          class="imagem-museu"
        />
      </div>
    </div>
  </section>

  <Footer />
</body>
</html>