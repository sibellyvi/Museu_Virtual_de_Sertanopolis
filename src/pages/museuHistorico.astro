---
import "../styles/museuHistorico.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const titulo = "Museu Histórico";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Para adicionar um marco novo, inclua mais um item aqui (na ordem em que deve aparecer)
const linhaDoTempo = [
  {
    data: "1992",
    titulo: "Inauguração",
    texto:
      "Criação do Museu Histórico de Sertanópolis, dedicado a reunir e preservar objetos e registros ligados à história do município e de sua comunidade.",
  },
  {
    data: "2009",
    titulo: "Período de fechamento e declínio",
    texto:
      "O museu deixa de funcionar regularmente. O acervo permanece, mas o acesso do público ao espaço torna-se limitado.",
  },
  {
    data: "2021",
    titulo: "Processo de regularização",
    texto:
      "Tem início o processo de regularização do museu, com a retomada dos cuidados com o acervo e com a documentação institucional.",
  },
  {
    data: "2026",
    titulo: "Museu Virtual de Sertanópolis",
    texto:
      "O projeto de extensão universitária do Museu Virtual de Sertanópolis nasce como iniciativa de preservação e de acesso digital ao patrimônio do atual museu renomeado para Museu Histórico, Cultural e Científico Ivaldo Totti — MC²IT, permitindo que as peças sejam conhecidas de qualquer lugar.",
  },
];
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{titulo}</title>
</head>

<body>
  <Header />

  <main class="pagina-museu">
    <section class="apresentacao">
      <span class="eyebrow">Museu Histórico, Cultural e Científico</span>
      <h1>“Ivaldo Totti” — MC²IT</h1>
      <p class="intro">
        O museu reúne peças históricas, culturais e científicas relacionadas à
        trajetória de Sertanópolis e de sua comunidade. Esta página apresenta a
        história da instituição e reserva espaço para documentos e registros que
        forem sendo reunidos pelo projeto.
      </p>
    </section>

    <figure class="figura-museu">
      <img
        src={`${base}/imagens/ImagemMuseu.jpg`}
        alt="Imagem do Museu em 2006"
        class="imagem-museu"
      />
      <figcaption>Imagem do Museu em 2006</figcaption>
    </figure>

    <figure class="figura-museu figura-revista">
      <img
        src={`${base}/imagens/revista.jpg`}
        alt="Folha de Londrina anunciando a inauguração do museu histórico de Sertanópolis"
        class="imagem-museu"
      />
      <figcaption>
        Folha de Londrina anunciando a inauguração do museu histórico de
        Sertanópolis
      </figcaption>
    </figure>

    <section class="linha-do-tempo" aria-labelledby="titulo-linha-do-tempo">
      <h2 id="titulo-linha-do-tempo">Linha do tempo</h2>

      <ol class="eventos">
        {
          linhaDoTempo.map((evento) => (
            <li class="evento">
              <span class="evento-data">{evento.data}</span>
              <h3>{evento.titulo}</h3>
              <p>{evento.texto}</p>
            </li>
          ))
        }
      </ol>
    </section>
  </main>

  <Footer />
</body>
</html>