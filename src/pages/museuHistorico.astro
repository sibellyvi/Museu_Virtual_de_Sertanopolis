---
import "../styles/museuHistorico.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const titulo = "Museu Histórico, Cultural e Científico Ivaldo Totti — MC²IT";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{titulo}</title>
</head>

<body>
  <Header />
  <h1>{titulo}</h1>
  <p>Conheça história do museu físico.</p>
  <img
src= `${base}/imagens/ImagemMuseu.jpg`
alt = "Imagem do Museu em 2006"
class = "imagem-museu"

/>
  <img
src= `${base}/imagens/revista.jpg`
alt = "Folha de Londrina anunciando a inauguração do museu histórico de Sertanópolis"
class = "imagem-museu"
/>

    <Footer />
</body>
</html>
